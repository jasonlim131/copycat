# Override the repo-root .gitignore which excludes *.txt
!requirements.txt

# Experiment outputs.
# Checkpoints are typically large (model weights); keep ignored.
results/checkpoints/
# Figures + trajectory JSONs are small and tracked so the sanity-check
# outputs are visible on the remote branch without re-running.
# (Override these for real experiment runs by uncommenting below.)
# results/figures/
# results/metrics/

# Python bytecode
__pycache__/
*.pyc
